{
  "name": "dsh-llm-codebuddy",
  "version": "1.3.6",
  "description": "通过 WorkBuddy API Key 或 CodeBuddy 登录令牌为 DeepSeek Harness 接入 CodeBuddy 模型",
  "author": "Axiaohungry",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codebuddy",
    "workbuddy",
    "llm",
    "provider"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-llm-codebuddy": "cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Axiaohungry/dsh-llm-codebuddy.git"
  },
  "homepage": "https://github.com/Axiaohungry/dsh-llm-codebuddy#readme",
  "bugs": {
    "url": "https://github.com/Axiaohungry/dsh-llm-codebuddy/issues"
  },
  "files": [
    "index.js",
    "codebuddy-auth.js",
    "codebuddy-credits.js",
    "codebuddy-web.js",
    "client.js",
    "cli.js",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check codebuddy-auth.js && node --check codebuddy-credits.js && node --check codebuddy-web.js && node --check client.js && node --check cli.js && node --test test.js && node cli.js --self-test"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@earendil-works/pi-ai": "0.82.1",
    "pnpm": "11.19.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
